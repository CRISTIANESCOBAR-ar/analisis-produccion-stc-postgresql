# Compose: copiar a .env y completar en el servidor, sin versionar secretos.
# Si ya existe un volumen, usar su contraseña ACTUAL. Cambiar esta variable
# no cambia la contraseña de PostgreSQL ni requiere recrear el volumen.
POSTGRES_PASSWORD=

# Acceso: usuario sin ':' y contraseña de al menos 16 caracteres.
STC_AUTH_USER=
STC_AUTH_PASSWORD=
# Orígenes adicionales exactos, separados por coma; misma origin es automática.
FRONTEND_ORIGIN=
GOOGLE_API_KEY=

# Carpeta de CSV del host. Vacío usa ./csv.
# Windows: C:\STC\CSV; Linux: /opt/stc/csv
STC_CSV_HOST_PATH=

# pgAdmin requiere --profile admin y contraseña.
STC_DB_BIND=127.0.0.1
STC_PGADMIN_BIND=127.0.0.1
PGADMIN_PASSWORD=
